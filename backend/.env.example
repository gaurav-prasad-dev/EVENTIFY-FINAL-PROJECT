PORT=4000
CLIENT_URL=http://localhost:5173

# ==========================================
# REDIS CONFIGURATION (Redis Cloud / Local)
# ==========================================
# For Redis Cloud:
# Format: redis://default:<password>@<redis-cloud-endpoint>:<port>
# Example: redis://default:abc123xyz@redis-12345.c12.us-east-1-2.ec2.cloud.redislabs.com:12345
# If TLS/SSL is enabled in Redis Cloud:
# Example: rediss://default:abc123xyz@redis-12345.c12.us-east-1-2.ec2.cloud.redislabs.com:12345
REDIS_URL=redis://localhost:6379

# Alternatively, you can specify individual variables:
# REDIS_HOST=redis-12345.c12.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_redis_cloud_password
# REDIS_TLS=false

# ==========================================
# DATABASE
# ==========================================
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventify?retryWrites=true&w=majority

# ==========================================
# EMAIL / SMTP (Nodemailer / Brevo)
# ==========================================
# Brevo SMTP Configuration (Recommended)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_PASS=your_brevo_smtp_key
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
BREVO_SENDER_NAME=Eventify

# Brevo REST API Configuration (Alternative)
BREVO_API_KEY=your_brevo_api_key

# Fallback Gmail SMTP (Local development)
MAIL_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRE=7d

# ==========================================
# OAUTH & THIRD PARTY
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret

TMDB_API_KEY=your_tmdb_api_key
EVENT_API_KEY=your_ticketmaster_event_api_key

QR_SECRET=your_qr_secret_key

# ==========================================
# TWILIO (SMS)
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone
